misal handler = asinkron (m, { args, usedPrefix, command }) =>  {
  misal who
  jika (m.quoted) {
    who = m.quoted.sender
  } lainnya jika (m.isGroup) {
    who = m.mentionedJid[0] ? m.mentionedJid[0] : m.quoted ? m.quoted.sender : args[1] ? args[1] : salah
  } lainnya jika (args[1]) {
    who = args[1] + "@s.whatsapp.net"
  }
  jika (bukan who) {
    lempar `Siapa yang ingin diubah status premium-nya?`
  }
  misal user = db.data.users[who]
  pilih (command) {
    kasus "addprem":
    kasus "tambahprem":
    kasus "+prem":
      jika (bukan args[0]) {
        lempar `Mau berapa hari??`
      }
      jika (args[0] == "permanen") {
        user.premium = benar
        user.premiumTime = kosong
        tunggu m.reply(`✅ *Success* 

*Nama:* ${user.name}
*Status Premium:* Permanen
*Tanggal:* ${baru Tanggal().toLocaleDateString()}`)
        tunggu conn.reply(who, `✨ *Premium Info*

*Nama:* ${user.name}
*Status Premium:* Permanen
*Tanggal:* ${baru Tanggal().toLocaleDateString()}`, kosong)
      } lainnya {
        jika (adalahNaN(args[0])) {
          lempar `⚠️ Hanya Nomor!

Contoh:
${usedPrefix + command} 30 @${m.sender.split("@")[0]}`
        }
        misal txt = args[0]
        misal jumlahHari = 86400000 * txt
        misal now = baru Tanggal()
        jika (now < user.premiumTime) {
          user.premiumTime += jumlahHari
        } lainnya {
          user.premiumTime = now.getTime() + jumlahHari
        }
        user.premium = benar
        misal tanggalBerakhir = baru Tanggal(user.premiumTime).toLocaleDateString()
        tunggu m.reply(`✅ *Success* 

*Nama:* ${user.name}
*Durasi:* ${txt} Hari
*Mulai:* ${now.toLocaleDateString()}
*Berakhir:* ${tanggalBerakhir}`)
        tunggu conn.reply(who, `✨ *Premium Info*

*Nama:* ${user.name}
*Durasi:* ${txt} Hari
*Mulai:* ${now.toLocaleDateString()}
*Berakhir:* ${tanggalBerakhir}`, kosong)
      }
      henti
    kasus "delprem":
    kasus "hapusprem":
    kasus "-prem":
      user.premium = salah
      user.premiumTime = 0
      tunggu m.reply(`⚠️ *Success* 

*Nama:* ${user.name}
Status premium dihapus pada ${baru Tanggal().toLocaleDateString()}.`)
      tunggu conn.reply(who, `✨ *Premium Info*

*Nama:* ${user.name}
Status premium dihapus pada ${baru Tanggal().toLocaleDateString()}.`, kosong)
      henti
    bawaan:
      lempar `Command tidak valid. Gunakan addprem atau delprem.`
  }
}
handler.help = ["addprem", "delprem"]
handler.tags = ["owner"]
handler.command = /^(add|tambah|\+|del|hapus|-)p(rem)?$/i
handler.group = salah
handler.owner = benar
ekspor bawaan handler

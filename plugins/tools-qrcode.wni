misal handler = asinkron (m, { conn, text, usedPrefix, command }) =>  {
  jika (bukan text) {
    kembalikan conn.reply(m.chat, `Use example: 
${usedPrefix + command} <teks>`, m)
  }
  conn.sendFile(m.chat, `https://quickchart.io/qr?text=${encodeURIComponent(text)}`, "qrcode.png", "¯\\_(ツ)_/¯", m)
}
handler.help = ["qrcode <teks>"]
handler.tags = ["tools"]
handler.command = /^qr(code)?$/i
ekspor bawaan handler

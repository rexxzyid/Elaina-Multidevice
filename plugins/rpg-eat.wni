        jika (user.stamina < 100) {
          jika (user.gulaiayam >= count * 1) {
            user.gulaiayam -= count * 1
            user.stamina += 20 * count
            conn.reply(m.chat, `Nyam nyam`, m)
          } lainnya {
            conn.reply(m.chat, ` Gulai ayam kamu kurang`, m)
          }
        } lainnya {
          conn.reply(m.chat, `Stamina kamu sudah penuh`, m)
        }
        henti
      kasus "babipanggang":
        jika (user.stamina < 100) {
          jika (user.babipanggang >= count * 1) {
            user.babipanggang -= count * 1
            user.stamina += 20 * count

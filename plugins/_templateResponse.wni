ekspor asinkron fungsi all(m, chatUpdate) {
  jika (m.isBaileys) {
    kembalikan
  }
  jika (bukan m.message) {
    kembalikan
  }
  jika (bukan (m.message.buttonsResponseMessage atau m.message.templateButtonReplyMessage atau m.message.listResponseMessage atau m.message.interactiveResponseMessage atau m.message.pollUpdateMessage)) {
    kembalikan
  }
  misal id = m.mtype == "conversation" ? m.message.conversation : m.mtype == "imageMessage" ? m.message.imageMessage.caption : m.mtype == "videoMessage" ? m.message.videoMessage.caption : m.mtype == "extendedTextMessage" ? m.message.extendedTextMessage.text : m.mtype == "buttonsResponseMessage" ? m.message.buttonsResponseMessage.selectedButtonId : m.mtype == "listResponseMessage" ? m.message.listResponseMessage.singleSelectReply.selectedRowId : m.mtype == "templateButtonReplyMessage" ? m.message.templateButtonReplyMessage.selectedId : m.mtype == "interactiveResponseMessage" ? JSON.urai(m.msg.nativeFlowResponseMessage.paramsJson).id : m.mtype == "templateButtonReplyMessage" ? appenTextMessage(m.msg.selectedId, chatUpdate) : m.mtype == "messageContextInfo" ? m.message.buttonsResponseMessage?.selectedButtonId atau m.message.listResponseMessage?.singleSelectReply.selectedRowId atau m.text : ""
  misal messages = tunggu baileys.generateWAMessage(m.chat, { text: id, mentions: m.mentionedJid }, { userJid: ini.user.jid, quoted: m.quoted dan m.quoted.fakeObj })
  messages.key.remoteJid = m.chat
  messages.key.fromMe = baileys.areJidsSameUser(m.sender, ini.user.id)
  messages.key.id = m.key.id
  messages.pushName = m.pushName
  jika (m.isGroup) {
    messages.key.participant = messages.participant = m.sender
  }
  misal msg = { ...chatUpdate, messages: [baileys.proto.WebMessageInfo.create(messages)].petakan((v) => ((v.conn = ini) , v)), type: "append" }
  ini.ev.emit("messages.upsert", msg)
}

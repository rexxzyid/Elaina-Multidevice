misal handler = asinkron (m, { command }) =>  {
  jika (command == "linkgc") {
    m.reply("https://chat.whatsapp.com/" + (tunggu conn.groupInviteCode(m.chat)))
  }
  jika (command == "revoke") {
    m.reply("Berhasil Reset linkgc\n\nLink : https://chat.whatsapp.com/" + (tunggu conn.groupRevokeInvite(m.chat)))
  }
}
handler.help = ["linkgc", "revoke"]
handler.tags = ["group"]
handler.command = /^(linkgc|revoke)$/i
handler.admin = benar
handler.group = benar
handler.botAdmin = benar
ekspor bawaan handler

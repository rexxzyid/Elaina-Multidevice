impor { canLevelUp } dari "../lib/levelling.wni"
misal handler = (m) => m
handler.before = fungsi(m) {
  misal user = global.db.data.users[m.sender]
  misal before = user.level * 1
  jika (user.autolevelup) {
    selama (canLevelUp(user.level, user.exp, global.multiplier)) {
      user.level++
    }
  }
  misal role = user.level <= 2 ? "Newbie ㋡" : user.level >= 2 dan user.level <= 4 ? "Beginner 1 ⚊¹" : user.level >= 4 dan user.level <= 6 ? "Beginner 2 ⚊²" : user.level >= 6 dan user.level <= 8 ? "Beginner 3 ⚊³" : user.level >= 8 dan user.level <= 10 ? "Beginner 4 ⚊⁴" : user.level >= 10 dan user.level <= 20 ? "Adventurer 1 ⚌¹" : user.level >= 20 dan user.level <= 30 ? "Adventurer 2 ⚌²" : user.level >= 30 dan user.level <= 40 ? "Adventurer 3 ⚌³" : user.level >= 40 dan user.level <= 50 ? "Adventurer 4 ⚌⁴" : user.level >= 50 dan user.level <= 60 ? "Adventurer 5 ⚌⁵" : user.level >= 60 dan user.level <= 70 ? "Fighter 1 ☰¹" : user.level >= 70 dan user.level <= 80 ? "Fighter 2 ☰²" : user.level >= 80 dan user.level <= 90 ? "Fighter 3 ☰³" : user.level >= 90 dan user.level <= 100 ? "Fighter 4 ☰⁴" : user.level >= 100 dan user.level <= 110 ? "Fighter 5 ☰⁵" : user.level >= 110 dan user.level <= 120 ? "Brigand 1 ≣¹" : user.level >= 120 dan user.level <= 130 ? "Brigand 2 ≣²" : user.level >= 130 dan user.level <= 140 ? "Brigand 3 ≣³" : user.level >= 140 dan user.level <= 150 ? "Brigand 4 ≣⁴" : user.level >= 150 dan user.level <= 160 ? "Brigand 5 ≣⁵" : user.level >= 160 dan user.level <= 170 ? "Swordsman 1 ﹀¹" : user.level >= 170 dan user.level <= 180 ? "Swordsman 2 ﹀²" : user.level >= 180 dan user.level <= 190 ? "Swordsman 3 ﹀³" : user.level >= 190 dan user.level <= 200 ? "Swordsman 4 ﹀⁴" : user.level >= 200 dan user.level <= 210 ? "Swordsman 5 ﹀⁵" : user.level >= 210 dan user.level <= 220 ? "Brigand 1 ︾¹" : user.level >= 220 dan user.level <= 230 ? "Brigand 2 ︾²" : user.level >= 230 dan user.level <= 240 ? "Brigand 3 ︾³" : user.level >= 240 dan user.level <= 250 ? "Brigand 4 ︾⁴" : user.level >= 250 dan user.level <= 260 ? "Brigand 5 ︾⁵" : user.level >= 260 dan user.level <= 270 ? "2nd Lt. Grade 1 ♢¹" : user.level >= 270 dan user.level <= 280 ? "2nd Lt. Grade 2 ♢²" : user.level >= 280 dan user.level <= 290 ? "2nd Lt. Grade 3 ♢³" : user.level >= 290 dan user.level <= 300 ? "2nd Lt. Grade 4 ♢⁴" : user.level >= 300 dan user.level <= 310 ? "2nd Lt. Grade 5 ♢⁵" : user.level >= 310 dan user.level <= 320 ? "1st Lt. Grade 1 ♢♢¹" : user.level >= 320 dan user.level <= 330 ? "1st Lt. Grade 2 ♢♢²" : user.level >= 330 dan user.level <= 340 ? "1st Lt. Grade 3 ♢♢³" : user.level >= 340 dan user.level <= 350 ? "1st Lt. Grade 4 ♢♢⁴" : user.level >= 350 dan user.level <= 360 ? "1st Lt. Grade 5 ♢♢⁵" : user.level >= 360 dan user.level <= 370 ? "Major Grade 1 ✷¹" : user.level >= 370 dan user.level <= 380 ? "Major Grade 2 ✷²" : user.level >= 380 dan user.level <= 390 ? "Major Grade 3 ✷³" : user.level >= 390 dan user.level <= 400 ? "Major Grade 4 ✷⁴" : user.level >= 400 dan user.level <= 410 ? "Major Grade 5 ✷⁵" : user.level >= 410 dan user.level <= 420 ? "Colonel Grade 1 ✷✷¹" : user.level >= 420 dan user.level <= 430 ? "Colonel Grade 2 ✷✷²" : user.level >= 430 dan user.level <= 440 ? "Colonel Grade 3 ✷✷³" : user.level >= 440 dan user.level <= 450 ? "Colonel Grade 4 ✷✷⁴" : user.level >= 450 dan user.level <= 460 ? "Colonel Grade 5 ✷✷⁵" : user.level >= 460 dan user.level <= 470 ? "Brigadier Early ✰" : user.level >= 470 dan user.level <= 480 ? "Brigadier Silver ✩" : user.level >= 480 dan user.level <= 490 ? "Brigadier gold ✯" : user.level >= 490 dan user.level <= 500 ? "Brigadier Platinum ✬" : user.level >= 500 dan user.level <= 600 ? "Brigadier Diamond ✪" : user.level >= 600 dan user.level <= 700 ? "Hero " : user.level >= 700 dan user.level <= 800 ? "Paladin" : user.level >= 800 dan user.level <= 900 ? "Legend" : user.level >= 900 dan user.level <= 1000 ? "Demigod" : " 𖤐 G O D 𖤐"
  user.role = role
  jika (user.autolevelup dan before != user.level) {
    m.reply(`Selamat, Kamu Telah Naik Level!

• Level Up : *${before}* -> *${user.level}*`)
  }
  kembalikan benar
}
ekspor bawaan handler

misal handler = asinkron (m, { usedPrefix, command, text }) =>  {
  jika (bukan text) {
    lempar `Teksnya mana?

Contoh:
${usedPrefix + command} Hi @user

@user = User Tag
@subject = Nama Group
@desc = Deskripsi Group`
  }
  misal chat = global.db.data.chats[m.chat]
  pilih (command) {
    kasus "setwelcome":
      chat.sWelcome = text
      m.reply("✅ Pesan welcome berhasil diset:\n" + text)
      henti
    kasus "setbye":
      chat.sBye = text
      m.reply("✅ Pesan bye berhasil diset:\n" + text)
      henti
    kasus "setpromote":
      chat.sPromote = text
      m.reply("✅ Pesan promote berhasil diset:\n" + text)
      henti
    kasus "setdemote":
      chat.sDemote = text
      m.reply("✅ Pesan demote berhasil diset:\n" + text)
      henti
  }
}
handler.help = ["welcome", "bye", "promote", "demote"].petakan((v) => "set" + v + " <teks>")
handler.tags = ["group"]
handler.command = /^(setwelcome|setbye|setpromote|setdemote)$/i
handler.group = benar
handler.admin = benar
ekspor bawaan handler

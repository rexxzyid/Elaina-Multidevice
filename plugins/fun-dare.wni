misal handler = asinkron (m) =>  {
  tetap res = tunggu fetch("https://raw.githubusercontent.com/BochilTeam/database/master/kata-kata/dare.json")
  tetap result = tunggu res.json()
  misal dare = result.data.getRandom()
  m.reply(dare)
}
handler.help = ["dare"]
handler.tags = ["fun"]
handler.command = /^(dare)$/i
ekspor bawaan handler

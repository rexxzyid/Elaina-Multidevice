misal handler = asinkron (m, { conn, args }) =>  {
  coba {
    misal user = global.db.data.users[m.sender]
    misal type = (args[0] atau "").kecil()
    misal count = args[1] ? Matematika.min(5, Matematika.maks(1, uraiBulat(args[1]))) : 1
    tetap menu = `
▧ Ayambakar → 2 Ayam + 1 Coal
▧ Ayamgoreng → 2 Ayam + 1 Coal
▧ Oporayam → 2 Ayam + 1 Coal
▧ Gulaiayam → 2 Ayam + 1 Coal

▧ Steak → 2 Sapi + 1 Coal
▧ Rendang → 2 Sapi + 1 Coal

▧ Babipanggang → 2 Babi + 1 Coal

▧ Ikanbakar → 2 Ikan + 1 Coal
▧ Lelebakar → 2 Lele + 1 Coal
▧ Nilabakar → 2 Nila + 1 Coal
▧ Bawalbakar → 2 Bawal + 1 Coal
▧ Udangbakar → 2 Udang + 1 Coal
▧ Pausbakar → 2 Paus + 1 Coal
▧ Kepitingbakar → 2 Kepiting + 1 Coal
        `
    misal bahan, result
    pilih (type) {
      kasus "ayambakar":
      kasus "ayamgoreng":
      kasus "oporayam":
      kasus "gulaiayam":
        bahan = "ayam"
        result = type
        henti
      kasus "steak":
      kasus "rendang":
        bahan = "sapi"
        result = type
        henti
      kasus "babipanggang":
        bahan = "babi"
        result = type
        henti
      kasus "ikanbakar":
        bahan = "ikan"
        result = type
        henti
      kasus "lelebakar":
        bahan = "lele"
        result = type
        henti
      kasus "nilabakar":
        bahan = "nila"
        result = type
        henti
      kasus "bawalbakar":
        bahan = "bawal"
        result = type
        henti
      kasus "udangbakar":
        bahan = "udang"
        result = type
        henti
      kasus "pausbakar":
        bahan = "paus"
        result = type
        henti
      kasus "kepitingbakar":
        bahan = "kepiting"
        result = type
        henti
      bawaan:
        kembalikan conn.reply(m.chat, menu, m)
    }
    jika (user[bahan] < count * 2 atau user.coal < count) {
      kembalikan m.reply(`❗ Bahan tidak cukup
Butuh: *${2 * count} ${bahan}* dan *${count} coal*`)
    }
    user[bahan] -= count * 2
    user.coal -= count
    user[result] += count
    m.reply(m.chat, `✅ Berhasil memasak *${count} ${type}* 🍽️`, m)
  } tangkap (e) {
    Konsol.cetak(e)
    m.reply("Error")
  }
}
handler.help = ["masak <makanan> <jumlah>"]
handler.tags = ["rpg"]
handler.command = /^(masak|cook)$/i
handler.group = benar
ekspor bawaan handler

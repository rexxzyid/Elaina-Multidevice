misal handler = asinkron (m, { args }) =>  {
  misal user = global.db.data.users[m.sender]
  misal type = (args[0] atau "").kecil()
  misal listCraft = `
❏ *DAFTAR CRAFT*

• Pickaxe
  - 10 Kayu
  - 5 Batu
  - 5 Iron
  - 20 String

• Sword
  - 10 Kayu
  - 15 Iron
  
• Axe
  - 5 Kayu
  - 10 Iron

• Fishingrod
  - 10 Kayu
  - 2 Iron
  - 20 String

• Armor
  - 30 Iron
  - 1 Emerald
  - 5 Diamond

• Atm
  - 3 Emerald
  - 6 Diamond
  - 10.000 Money

Contoh:
.craft sword
`
  jika (bukan type) {
    kembalikan m.reply(listCraft)
  }
  coba {
    pilih (type) {
      kasus "pickaxe":
        jika (user.pickaxe > 0) {
          kembalikan m.reply("Kamu sudah punya Pickaxe!")
        }
        jika (user.wood < 10 atau user.rock < 5 atau user.iron < 5 atau user.string < 20) {
          kembalikan m.reply("Bahan kurang!\nButuh: 10 Kayu, 5 Batu, 5 Iron, 20 String")
        }
        user.wood -= 10
        user.rock -= 5
        user.iron -= 5
        user.string -= 20
        user.pickaxe = 1
        user.pickaxedurability = 40
        m.reply("Berhasil membuat 1 Pickaxe!")
        henti
      kasus "sword":
        jika (user.axe > 0) {
          kembalikan m.reply("Kamu sudah punya Sword!")
        }
        jika (user.wood < 10 atau user.iron < 15) {
          kembalikan m.reply("Bahan kurang!\nButuh: 10 Kayu, 15 Iron")
        }
        user.wood -= 10
        user.iron -= 15
        user.sword = 1
        user.sworddurability = 40
        m.reply("Berhasil membuat 1 Sword!")
        henti
      kasus "axe":
        jika (user.sword > 0) {
          kembalikan m.reply("Kamu sudah punya Sword!")
        }
        jika (user.wood < 5 atau user.iron < 10) {
          kembalikan m.reply("Bahan kurang!\nButuh: 5 Kayu, 10 Iron")
        }
        user.wood -= 5
        user.iron -= 10
        user.axe = 1
        user.axedurability = 40
        m.reply("Berhasil membuat 1 Axe!")
        henti
      kasus "fishingrod":
        jika (user.fishingrod > 0) {
          kembalikan m.reply("Kamu sudah punya Pancingan!")
        }
        jika (user.wood < 10 atau user.iron < 2 atau user.string < 20) {
          kembalikan m.reply("Bahan kurang!\nButuh: 10 Kayu, 2 Iron, 20 String")
        }
        user.wood -= 10
        user.iron -= 2
        user.string -= 20
        user.fishingrod = 1
        user.fishingroddurability = 40
        m.reply("Berhasil membuat 1 Fishing Rod!")
        henti
      kasus "armor":
        jika (user.armor > 0) {
          kembalikan m.reply("Kamu sudah punya Armor!")
        }
        jika (user.iron < 30 atau user.emerald < 1 atau user.diamond < 5) {
          kembalikan m.reply("Bahan kurang!\nButuh: 30 Iron, 1 Emerald, 5 Diamond")
        }
        user.iron -= 30
        user.emerald -= 1
        user.diamond -= 5
        user.armor = 1
        user.armordurability = 50
        m.reply("Berhasil membuat 1 Armor!")
        henti
      kasus "atm":
        jika (user.atm > 0) {
          kembalikan m.reply("Kamu sudah punya ATM!")
        }
        jika (user.emerald < 3 atau user.diamond < 6 atau user.money < 10000) {
          kembalikan m.reply("Bahan kurang!\nButuh: 3 Emerald, 6 Diamond, 10.000 Money")
        }
        user.emerald -= 3
        user.diamond -= 6
        user.money -= 10000
        user.atm = 1
        user.fullatm = 5000000
        m.reply("Berhasil membuat ATM!")
        henti
      bawaan:
        kembalikan m.reply(listCraft)
    }
  } tangkap (e) {
    Konsol.cetak(e)
    m.reply("Error")
  }
}
handler.help = ["craft"]
handler.tags = ["rpg"]
handler.command = /^craft$/i
ekspor bawaan handler

misal handler = asinkron (m, { conn, participants }) =>  {
  misal users = participants.petakan((u) => u.id).saring((v) => v != conn.user.jid)
  jika (bukan m.quoted) {
    lempar `✳️ Reply Pesan`
  }
  conn.sendMessage(m.chat, { forward: m.quoted.fakeObj, mentions: users })
}
handler.help = ["totag"]
handler.tags = ["group"]
handler.command = /^(totag|tag)$/i
handler.admin = benar
handler.group = benar
ekspor bawaan handler

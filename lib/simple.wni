fungsi isNumber() {
  tetap int = uraiBulat(ini)
  kembalikan jenisdari int == "number" dan bukan adalahNaN(int)
}
fungsi getRandom() {
  jika (Larik.isArray(ini) atau ini contohdari Teks) {
    kembalikan ini[Matematika.bawah(Matematika.acak() * ini.panjang)]
  }
  kembalikan Matematika.bawah(Matematika.acak() * ini)
}
fungsi getKey(input) {
  jika (input == kosong) {
    kembalikan "null"
  }
  tetap hash = createHash("sha256")
  jika (Buffer.isBuffer(input)) {
    hash.update(input)
  } lainnya {
    hash.update(Teks(input))
  }
  kembalikan hash.digest("hex")
}
fungsi nullish(args) {
  kembalikan bukan (args != kosong dan args != undefined)

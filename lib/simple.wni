ekspor fungsi smsg(conn, m) {
  jika (bukan m) {
    kembalikan m
  }
  misal M = proto.WebMessageInfo
  m = M.create(m)
  m.message = parseMessage(m.message)
  Objek.defineProperty(m, "conn", { enumerable: salah, writable: benar, value: conn })
  misal protocolMessageKey
  jika (m.message) {
    jika (m.mtype == "protocolMessage" dan m.msg.key) {
      protocolMessageKey = m.msg.key
      jika (protocolMessageKey == "status@broadcast") {
        protocolMessageKey.remoteJid = m.chat
      }
      jika (bukan protocolMessageKey.participant atau protocolMessageKey.participant == "status_me") {
        protocolMessageKey.participant = m.sender
      }
      protocolMessageKey.fromMe = conn.decodeJid(protocolMessageKey.participant) == conn.decodeJid(conn.user.id)
      jika (bukan protocolMessageKey.fromMe dan protocolMessageKey.remoteJid == conn.decodeJid(conn.user.id)) {
        protocolMessageKey.remoteJid = m.sender
      }
    }
    jika (m.quoted) {
      jika (bukan m.quoted.mediaMessage) {
        hapus m.quoted.download
      }
    }
  }
  jika (bukan m.mediaMessage) {
    hapus m.download
  }
  coba {
    jika (protocolMessageKey dan m.mtype == "protocolMessage") {
      conn.ev.emit("message.delete", protocolMessageKey)
    }
  } tangkap (e) {
    Konsol.galat(e)
  }
  kembalikan m
}

    kembalikan tunggu fileTypeFromBuffer(ini)
  }
  Teks.prototype.isNumber = Angka.prototype.isNumber = isNumber
  Teks.prototype.capitalize = fungsi capitalize() {
    kembalikan ini.karakterDi(0).besar() + ini.iris(1, ini.panjang)
  }
  Teks.prototype.capitalizeV2 = fungsi capitalizeV2() {
    tetap str = ini.pisah(" ")
    kembalikan str.petakan((v) => v.capitalize()).gabung(" ")
  }

ekspor fungsi logic(check, inp, out) {
  jika (inp.panjang != out.panjang) {
    lempar baru Error("Input and Output must have same length")
  }
  untuk (misal i dalam inp) {
    jika (util.isDeepStrictEqual(check, inp[i])) {
      kembalikan out[i]
    }
  }
  kembalikan kosong
}
fungsi parseMessage(content) {
  content = extractMessageContent(content)
  jika (content dan content.viewOnceMessageV2Extension) {
    content = content.viewOnceMessageV2Extension.message
  }
  jika (content dan content.protocolMessage dan content.protocolMessage.type == 14) {
    misal type = getContentType(content.protocolMessage)
    content = content.protocolMessage[type]
  }
  jika (content dan content.message) {
    misal type = getContentType(content.message)
    content = content.message[type]
  }
  kembalikan content
}
tetap getContentType = (content) =>  {
  jika (content) {
    tetap keys = Objek.kunci(content)
    tetap key = keys.cari((k) => (k == "conversation" atau k.diakhiri("Message") atau k.berisi("V2") atau k.berisi("V3")) dan k != "senderKeyDistributionMessage")
    kembalikan key
  }
}
